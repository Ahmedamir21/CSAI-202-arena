%% SwiftShip ER diagram - page 1: entities and relationships only.
%% Mermaid has no diamond-on-an-edge, so relationships are hexagons ({{ }});
%% the draw.io file in this folder draws them as real diamonds.
%% "{{ }}" = relationship, "[[ ]]" = weak entity (double rectangle),
%% "===" = thick link, used for total participation (double line).
flowchart LR
  UA[UserAccount]
  CU[Customer]
  EM[Employee]
  CO[Courier]
  BE[BranchEmployee]
  BR[Branch]
  CI[City]
  ZO[Zone]
  AD[Address]
  SH[Shipment]
  SS[[ShipmentStatusHistory]]
  PT[PackageType]
  SL[ServiceLevel]
  PR[PricingRule]
  PA[Payment]
  CM[Complaint]
  AN{{"note: Admin is a ROLE of Employee"}}

  UA ---|"(0,1)"| R1{{HAS_CUSTOMER_PROFILE}} ---|"(1,1)"| CU
  UA ---|"(0,1)"| R2{{HAS_EMPLOYEE_RECORD}} ---|"(1,1)"| EM
  EM --- ISA{{"IS_A (inheritance)"}}
  ISA --- CO
  ISA --- BE
  EM -.- AN
  EM -.->|"supervisor (0,n)"| R4{{SUPERVISES}} -.->|"subordinate (0,1)"| EM
  BR ---|"(0,n)"| R5{{EMPLOYS}} ---|"(1,1)"| EM
