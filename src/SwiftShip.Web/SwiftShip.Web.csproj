<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SwiftShip.Web</RootNamespace>
    <AssemblyName>SwiftShip.Web</AssemblyName>
    <UserSecretsId>swiftship-web-csai202</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only package we need: the SQL Server driver. Data access is plain ADO.NET. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />
  </ItemGroup>

</Project>
