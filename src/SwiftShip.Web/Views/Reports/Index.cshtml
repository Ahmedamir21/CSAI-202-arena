@model ManagerialReportViewModel
@{
    ViewData["Title"] = "Reports";
    Layout = "_AppLayout";
    var k = Model.Kpis;
}
<div class="row-between">
    <h3 class="mb-0">How the company is doing</h3>
    <form asp-controller="Reports" asp-action="Index" method="get" class="row no-print">
        <input asp-for="FromDate" type="date" style="width:auto" />
        <input asp-for="ToDate" type="date" style="width:auto" />
        <button type="submit" class="btn btn-primary btn-sm">Apply the dates</button>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-ghost btn-sm">All time</a>
    </form>
</div>

@if (k != null)
{
    <div class="grid grid-4 mt-2">
        <div class="kpi accent-glow">
            <div class="kpi-label">Shipments</div>
            <div class="kpi-value" data-count="@k.TotalShipments">0</div>
            <div class="kpi-note">@k.DeliveredShipments of them delivered</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Revenue</div>
            <div class="kpi-value" data-count="@k.Revenue" data-decimals="2">0</div>
            <div class="kpi-note">EGP</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Delivered</div>
            <div class="kpi-value" data-count="@k.DeliveredPercent" data-decimals="1">0</div>
            <div class="kpi-note">percent of all shipments</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">On time</div>
            <div class="kpi-value" data-count="@k.OnTimePercent" data-decimals="1">0</div>
            <div class="kpi-note">percent before the promised date</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Late right now</div>
            <div class="kpi-value" data-count="@k.DelayedShipments">0</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Average delivery</div>
            <div class="kpi-value" data-count="@k.AverageDeliveryHours" data-decimals="1">0</div>
            <div class="kpi-note">hours from booking to door</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Rating</div>
            <div class="kpi-value" data-count="@k.AverageRating" data-decimals="2">0</div>
            <div class="kpi-note">out of 5</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">Open complaints</div>
            <div class="kpi-value" data-count="@k.OpenComplaints">0</div>
        </div>
    </div>
}

<div class="row mt-3">
    <a asp-controller="Reports" asp-action="Statistical" class="btn btn-primary">Statistical reports</a>
    <a asp-controller="Reports" asp-action="Detailed" class="btn">Reports about one courier, branch or customer</a>
</div>

<div class="grid grid-2 mt-3">
    <div>
        <div class="row-between">
            <h4>Revenue by branch</h4>
            <a asp-controller="Reports" asp-action="Csv" asp-route-report="revenue-by-branch"
               asp-route-from="@(Model.FromDate?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               class="btn btn-sm btn-ghost no-print">CSV</a>
        </div>
        @await Html.PartialAsync("_Chart", Model.RevenueByBranch)
    </div>

    <div>
        <div class="row-between">
            <h4>Best couriers</h4>
            <a asp-controller="Reports" asp-action="Csv" asp-route-report="leaderboard" class="btn btn-sm btn-ghost no-print">CSV</a>
        </div>
        @await Html.PartialAsync("_Chart", Model.Leaderboard)
    </div>

    <div>
        <div class="row-between">
            <h4>Busiest routes</h4>
            <a asp-controller="Reports" asp-action="Csv" asp-route-report="routes" class="btn btn-sm btn-ghost no-print">CSV</a>
        </div>
        @await Html.PartialAsync("_Chart", Model.Routes)
    </div>

    <div>
        <div class="row-between">
            <h4>Delivered on time or late</h4>
            <a asp-controller="Reports" asp-action="Csv" asp-route-report="ontime"
               asp-route-from="@(Model.FromDate?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               class="btn btn-sm btn-ghost no-print">CSV</a>
        </div>
        @await Html.PartialAsync("_Chart", Model.OnTime)
    </div>
</div>

<div class="card mt-3">
    <div class="row-between">
        <h4 class="mb-0">Complaints</h4>
        <a asp-controller="Reports" asp-action="Csv" asp-route-report="complaints" class="btn btn-sm btn-ghost no-print">CSV</a>
    </div>
    <div class="grid grid-2">
        <div>@await Html.PartialAsync("_Chart", Model.Complaints)</div>
        <div>@await Html.PartialAsync("_ReportTable", Model.Complaints?.Tables?.FirstOrDefault())</div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}
