@model ReportPageViewModel
@{
    ViewData["Title"] = "Statistical reports";
    Layout = "_AppLayout";

    var tabs = new[]
    {
        new { Key = "status",  Label = "By status" },
        new { Key = "month",   Label = "Per month" },
        new { Key = "revenue", Label = "Revenue per month" },
        new { Key = "service", Label = "By service level" },
        new { Key = "cities",  Label = "Top cities" }
    };

    string Active(string key) => string.Equals(Model.Report, key) ? "btn-primary" : "btn-ghost";
}
<h3 class="mb-0">Statistical reports</h3>
<p class="small muted">How many parcels, when, and how much money they brought in.</p>

<div class="row mt-1 no-print">
    @foreach (var t in tabs)
    {
        <a asp-controller="Reports" asp-action="Statistical" asp-route-report="@t.Key"
           class="btn btn-sm @Active(t.Key)">@t.Label</a>
    }
</div>

<div class="card mt-2">
    <form asp-controller="Reports" asp-action="Statistical" method="get" class="row-between no-print">
        <input type="hidden" name="report" value="@Model.Report" />
        <div class="row">
            <div>
                <label class="small muted">From</label>
                <input name="from" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" style="width:auto" />
            </div>
            <div>
                <label class="small muted">To</label>
                <input name="to" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" style="width:auto" />
            </div>
            <div>
                <label class="small muted">How many rows</label>
                <input name="topN" type="number" min="1" max="100" value="@Model.TopN" style="width:100px" />
            </div>
        </div>
        <div class="row">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-controller="Reports" asp-action="Csv"
               asp-route-report="@Model.Report"
               asp-route-from="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-to="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-topN="@Model.TopN"
               class="btn btn-ghost">Download CSV</a>
            <button type="button" class="btn btn-ghost" onclick="window.print()">Print</button>
        </div>
    </form>
</div>

@if (Model.Data == null)
{
    <div class="card mt-2"><div class="empty"><p>Nothing to show yet.</p></div></div>
}
else
{
    <div class="card mt-2">
        <div class="row-between">
            <div>
                <h3 class="mb-0">@Model.Data.Title</h3>
                <p class="small muted mb-0">@Model.Data.Description</p>
            </div>
        </div>

        <div class="mt-2">
            @await Html.PartialAsync("_Chart", Model.Data)
        </div>

        <div class="mt-2">
            @foreach (var table in Model.Data.Tables)
            {
                <div class="mt-2">
                    <h4>@table.Title</h4>
                    @await Html.PartialAsync("_ReportTable", table)
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}
