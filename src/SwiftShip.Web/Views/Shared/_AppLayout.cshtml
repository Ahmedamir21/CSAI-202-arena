@* The layout of every page behind the login: a sidebar with the operations of the role,
   a top bar with the name of the user, and the content in the middle. *@
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SwiftShip</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/swiftship.css" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 7h11v9H3z" stroke="var(--accent)" stroke-width="2" />
                    <path d="M14 10h4l3 3v3h-7z" stroke="var(--accent)" stroke-width="2" />
                </svg>
                SwiftShip
            </div>
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="row">
                    <button type="button" class="burger" onclick="swiftshipToggleSidebar()" aria-label="Menu">&#9776;</button>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="row">
                    <span class="small muted">@ViewBag.Me?.BranchName</span>
                    <span class="chip chip-atbranch">@ViewBag.Me?.Role</span>
                    <span class="small">@ViewBag.Me?.DisplayName</span>
                    <button type="button" class="theme-toggle" aria-label="Switch to light mode">&#9788;</button>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-ghost no-print">Sign out</a>
                </div>
            </header>

            <div class="content">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-error">@ViewBag.Error</div>
                }
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <div id="toasts"></div>
    <script src="~/js/swiftship.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
