@model SwiftShip.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    Layout = "_AppLayout";
}
<div style="max-width:520px">
    <div class="card">
        <h3>Change your password</h3>

        @if (Model.FirstLogin)
        {
            <div class="alert alert-warning">
                This account was created for you, so please choose your own password before you
                go any further.
            </div>
        }

        @if (Model.Error != null)
        {
            <div class="alert alert-error">@Model.Error</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" data-validate>
            <div class="field">
                <label asp-for="CurrentPassword">Current password</label>
                <input asp-for="CurrentPassword" type="password" data-required />
            </div>
            <div class="field">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" type="password" data-required />
                <div class="hint">At least 8 characters.</div>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">New password again</label>
                <input asp-for="ConfirmPassword" type="password" data-required />
            </div>
            <button type="submit" class="btn btn-primary">Save the new password</button>
        </form>
    </div>
</div>
